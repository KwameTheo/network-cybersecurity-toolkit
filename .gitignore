# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual Environments
.venv/
venv/
ENV/
env/

# Data & Output files (preventing accidental commit of system logs & diagnostic scans)
*.db
*.sqlite3
reports/
logs/*.log
!logs/.gitkeep

# PyInstaller build artifacts
dist/
build/
*.spec

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
Desktop.ini
